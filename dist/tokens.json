{
  "name": "nyx",
  "version": "1.1.0",
  "$description": "NYX design tokens, derived from nyx.css :root. Some values reference other tokens via CSS var()/color-mix().",
  "themes": {
    "dark": {
      "color": {
        "bg": {
          "$value": "#0a0b0f",
          "$type": "color",
          "cssVar": "--nyx-bg"
        },
        "surface": {
          "$value": "#12141a",
          "$type": "color",
          "cssVar": "--nyx-surface"
        },
        "surface-2": {
          "$value": "#1c1f2a",
          "$type": "color",
          "cssVar": "--nyx-surface-2"
        },
        "border": {
          "$value": "#2a2d3a",
          "$type": "color",
          "cssVar": "--nyx-border"
        },
        "accent": {
          "$value": "#6c63ff",
          "$type": "color",
          "cssVar": "--nyx-accent"
        },
        "accent-2": {
          "$value": "#00d4aa",
          "$type": "color",
          "cssVar": "--nyx-accent-2"
        },
        "danger": {
          "$value": "#ff4d6a",
          "$type": "color",
          "cssVar": "--nyx-danger"
        },
        "warning": {
          "$value": "#ffb020",
          "$type": "color",
          "cssVar": "--nyx-warning"
        },
        "text": {
          "$value": "#e8eaf0",
          "$type": "color",
          "cssVar": "--nyx-text"
        },
        "text-muted": {
          "$value": "#6b7280",
          "$type": "color",
          "cssVar": "--nyx-text-muted"
        },
        "glass": {
          "$value": "rgba(255,255,255,0.04)",
          "$type": "color",
          "cssVar": "--nyx-glass"
        },
        "navbar-bg": {
          "$value": "rgba(10,11,15,.72)",
          "$type": "color",
          "cssVar": "--nyx-navbar-bg"
        },
        "overlay-bg": {
          "$value": "rgba(5,6,10,.65)",
          "$type": "color",
          "cssVar": "--nyx-overlay-bg"
        },
        "elev-hover": {
          "$value": "rgba(255,255,255,.08)",
          "$type": "color",
          "cssVar": "--nyx-elev-hover"
        },
        "glass-border": {
          "$value": "rgba(255,255,255,.08)",
          "$type": "color",
          "cssVar": "--nyx-glass-border"
        },
        "shimmer": {
          "$value": "#252836",
          "$type": "color",
          "cssVar": "--nyx-shimmer"
        },
        "success": {
          "$value": "var(--nyx-accent-2)",
          "$type": "color",
          "cssVar": "--nyx-success"
        }
      },
      "radius": {
        "radius-sm": {
          "$value": "6px",
          "$type": "dimension",
          "cssVar": "--nyx-radius-sm"
        },
        "radius": {
          "$value": "10px",
          "$type": "dimension",
          "cssVar": "--nyx-radius"
        },
        "radius-lg": {
          "$value": "16px",
          "$type": "dimension",
          "cssVar": "--nyx-radius-lg"
        },
        "radius-xl": {
          "$value": "24px",
          "$type": "dimension",
          "cssVar": "--nyx-radius-xl"
        },
        "radius-full": {
          "$value": "9999px",
          "$type": "dimension",
          "cssVar": "--nyx-radius-full"
        }
      },
      "shadow": {
        "shadow-sm": {
          "$value": "0 1px 3px rgba(0,0,0,.4)",
          "$type": "shadow",
          "cssVar": "--nyx-shadow-sm"
        },
        "shadow": {
          "$value": "0 4px 16px rgba(0,0,0,.5)",
          "$type": "shadow",
          "cssVar": "--nyx-shadow"
        },
        "shadow-lg": {
          "$value": "0 12px 40px rgba(0,0,0,.6)",
          "$type": "shadow",
          "cssVar": "--nyx-shadow-lg"
        },
        "glow": {
          "$value": "0 0 24px color-mix(in srgb,var(--nyx-accent) 35%,transparent)",
          "$type": "shadow",
          "cssVar": "--nyx-glow"
        },
        "glow-danger": {
          "$value": "0 0 24px color-mix(in srgb,var(--nyx-danger) 38%,transparent)",
          "$type": "shadow",
          "cssVar": "--nyx-glow-danger"
        }
      },
