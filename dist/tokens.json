        "fs-sm": {
          "$value": "13px",
          "$type": "dimension",
          "cssVar": "--nyx-fs-sm"
        },
        "fs-base": {
          "$value": "15px",
          "$type": "dimension",
          "cssVar": "--nyx-fs-base"
        },
        "fs-lg": {
          "$value": "17px",
          "$type": "dimension",
          "cssVar": "--nyx-fs-lg"
        },
        "fs-xl": {
          "$value": "22px",
          "$type": "dimension",
          "cssVar": "--nyx-fs-xl"
        },
        "fs-2xl": {
          "$value": "30px",
          "$type": "dimension",
          "cssVar": "--nyx-fs-2xl"
        },
        "fs-3xl": {
          "$value": "42px",
          "$type": "dimension",
          "cssVar": "--nyx-fs-3xl"
        }
      },
      "spacing": {
        "s1": {
          "$value": "4px",
          "$type": "dimension",
          "cssVar": "--nyx-s1"
        },
        "s2": {
          "$value": "8px",
          "$type": "dimension",
          "cssVar": "--nyx-s2"
        },
        "s3": {
          "$value": "12px",
          "$type": "dimension",
          "cssVar": "--nyx-s3"
        },
        "s4": {
          "$value": "16px",
          "$type": "dimension",
          "cssVar": "--nyx-s4"
        },
        "s5": {
          "$value": "24px",
          "$type": "dimension",
          "cssVar": "--nyx-s5"
        },
        "s6": {
          "$value": "32px",
          "$type": "dimension",
          "cssVar": "--nyx-s6"
        },
        "s7": {
          "$value": "48px",
          "$type": "dimension",
          "cssVar": "--nyx-s7"
        },
        "s8": {
          "$value": "64px",
          "$type": "dimension",
          "cssVar": "--nyx-s8"
        },
        "s9": {
          "$value": "96px",
          "$type": "dimension",
          "cssVar": "--nyx-s9"
        }
      },
      "fontFamily": {
        "font-display": {
          "$value": "'Plus Jakarta Sans',system-ui,sans-serif",
          "$type": "fontFamily",
          "cssVar": "--nyx-font-display"
        },
        "font-body": {
          "$value": "'Inter',system-ui,sans-serif",
          "$type": "fontFamily",
          "cssVar": "--nyx-font-body"
        },
        "font-mono": {
          "$value": "'JetBrains Mono',ui-monospace,monospace",
          "$type": "fontFamily",
          "cssVar": "--nyx-font-mono"
        },
        "font-ar": {
          "$value": "'IBM Plex Sans Arabic','Inter',system-ui,sans-serif",
          "$type": "fontFamily",
          "cssVar": "--nyx-font-ar"
        },
        "font-ar-display": {
          "$value": "'Aref Ruqaa','Lalezar',serif",
          "$type": "fontFamily",
          "cssVar": "--nyx-font-ar-display"
        }
      },
      "easing": {
        "ease": {
          "$value": "cubic-bezier(.4,0,.2,1)",
          "$type": "cubicBezier",
          "cssVar": "--nyx-ease"
